    // ── SAR ────────────────────────────────────────────────────────────────────
    async function loadSar() {
        const el = document.getElementById('sarMain');
        try {
            const days = getDays();
            const sym  = encodeURIComponent(currentSymbol);
            const [ohlcRes, sarRes, emaRes] = await Promise.all([
                fetch(`/Stock/DailyData?symbol=${sym}&days=${days}`),
                fetch(`/Stock/SAR?symbol=${sym}&days=${days}`),
                fetch(`/Stock/EMA?symbol=${sym}&days=${days}&period=20`)
            ]);
            const ohlcData = await ohlcRes.json();
            const sarData  = await sarRes.json();
            const emaData  = await emaRes.json();

            const dates      = ohlcData.map(d => fmtDate(d.date));
            const ohlcSeries = ohlcData.map(d => [d.open, d.close, d.low, d.high]);

            const dateIndexMap = {};
            dates.forEach((d, i) => { dateIndexMap[d] = i; });

            const sarDates  = (sarData.dates  || []).map(d => fmtDate(d));
            const sarValues = sarData.values  || [];
            const sarScatter = sarDates.map((d, i) => {
                const idx = dateIndexMap[d];
                return idx !== undefined ? [idx, sarValues[i]] : null;
            }).filter(p => p !== null && p[1] != null);

            const chart = initChart(el);
            chart.setOption({
                backgroundColor: 'transparent',
                textStyle: baseTextStyle,
                animation: false,
                tooltip: { trigger: 'axis', axisPointer: { type: 'cross' }, backgroundColor: '#fff', borderColor: '#dee2e6', textStyle: { color: '#344767' } },
                legend: { data: ['Candles','SAR','EMA20'], textStyle: { color: '#8392AB' }, top: 4 },
                grid: { left: 60, right: 20, top: 50, bottom: 60 },
                xAxis: { type: 'category', data: dates, axisLine: axisLineStyle, axisLabel: { color: '#8392AB', fontSize: 10 }, splitLine: { lineStyle: { color: '#e9ecef' } } },
                yAxis: { scale: true, axisLine: axisLineStyle, axisLabel: { color: '#8392AB' }, splitLine: { lineStyle: { color: '#e9ecef' } } },
                dataZoom: [
                    { type: 'inside', start: 0, end: 100 },
                    { type: 'slider', bottom: 4, height: 20, borderColor: '#dee2e6', fillerColor: 'rgba(94,114,228,0.1)', handleStyle: { color: '#5e72e4' }, textStyle: { color: '#8392AB' } }
                ],
                series: [
                    { name: 'Candles', type: 'candlestick', data: ohlcSeries, itemStyle: { color: '#00da3c', color0: '#ec0000', borderColor: '#00da3c', borderColor0: '#ec0000' } },
                    {
                        name: 'SAR', type: 'scatter',
                        data: sarScatter,
                        symbol: 'circle', symbolSize: 4,
                        itemStyle: { color: '#ff9c00' }
                    },
                    { name: 'EMA20', type: 'line', data: emaData.values || [], showSymbol: false, lineStyle: { color: '#00e5ff', width: 1.5 }, itemStyle: { color: '#00e5ff' } }
                ]
            });
            // resize handled by ResizeObserver in initChart
        } catch(e) {
            showError('sarMain', `SAR failed: ${e.message}`);
        }
    }
